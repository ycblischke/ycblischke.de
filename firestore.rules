rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kundenprofil: nur der eingeloggte Kunde selbst darf lesen/schreiben
    match /customers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Bestellungen: Kunde darf eigene anlegen, lesen und (beim Konto-Löschen)
    // löschen, aber nicht nachträglich ändern
    match /orders/{orderId} {
      // Kunden dürfen nur unverbindliche Anfragen anlegen - ein Status wie
      // "bezahlt" kann nur die Server-Funktion (PayPal) setzen
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'items', 'total', 'createdAt']);
      allow read, delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }
  }
}
